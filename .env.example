# Copy jadi .env dan isi nilai asli
BOT_TOKEN=          # base64/plain token @yourbot dari @BotFather
# Solver bayar: capsolver / 2captcha / anti-captcha / nocaptchaai (punya sendiri)
# Bentuk endpoint: POST JSON {url, sitekey, action} -> respons {token}
SOLVER_URL=
SOLVER_KEY=
